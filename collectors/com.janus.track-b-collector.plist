<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.janus.track-b-collector</string>
  <key>Program</key>
  <string>/bin/zsh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/bernardodelrio/Code/Janus/collectors/run_track_b.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/bernardodelrio/Code/Janus</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <!-- QoS FIX 2026-08-19. Was: Nice 19 + LowPriorityIO + ProcessType Background, which pinned this
       process at runtime priority 4. This sampler must hit t=0/0.5/1/2/3/5 s targets after each
       window open; at priority 4 on a swapping host it could not, producing 19,843 `scheduler_late`
       gaps and a capture rate of 11.3% at t=0 against a registered >=98% gate. This is the SAME
       pathology that made com.janus.ibkr-gateway unusable (priority 4 -> paged-out JVM -> 10 s TLS
       timeouts), fixed there by ProcessType Interactive. Same fix here. -->
  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
