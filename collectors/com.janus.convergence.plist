<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.janus.convergence</string>
  <key>Program</key>
  <string>/bin/zsh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/bernardodelrio/Code/Janus/collectors/run_convergence.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/bernardodelrio/Code/Janus</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <!-- ProcessType Interactive, and deliberately NO Nice / NO LowPriorityIO. Background QoS pinned
       com.janus.ibkr-gateway and com.janus.track-b-collector at runtime priority 4 and broke both
       (10s TLS timeouts; 19,843 scheduler_late gaps). Not repeating it a fourth time. -->
  <key>ProcessType</key>
  <string>Interactive</string>
  <!-- NO StandardOutPath/StandardErrorPath here. A gui LaunchAgent cannot create them on the
       external /Volumes/Kilos volume and fails EX_CONFIG(78) BEFORE exec, with no logs to explain
       itself (learned on com.janus.ibkr-archive). The redirect lives in run_convergence.sh. -->
</dict>
</plist>
