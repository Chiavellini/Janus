<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.janus.ibkr-archive</string>
  <key>Program</key>
  <string>/bin/zsh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/bernardodelrio/Code/Janus/collectors/run_ibkr_archive.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/bernardodelrio/Code/Janus</string>
  <!-- No Standard{Out,Error}Path: launchd cannot create these on /Volumes/Kilos and fails the
       job with EX_CONFIG(78) before exec. run_ibkr_archive.sh does the redirect itself. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>Nice</key>
  <integer>19</integer>
  <key>ProcessType</key>
  <string>Standard</string>
</dict>
</plist>
