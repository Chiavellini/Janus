[Unit]
Description=Janus Polymarket winning-position redemption
After=network-online.target janus-creds.service
Requires=janus-creds.service

[Service]
Type=oneshot
User=janus
EnvironmentFile=/etc/janus.env
WorkingDirectory=/opt/janus
# EnvironmentFile supplies the trading interpreter. Override it at the final exec boundary so the
# redemption job cannot silently inherit /opt/janus/.venv.
ExecStart=/usr/bin/zsh -c 'JANUS_PYTHON=/opt/janus/.redeem-venv/bin/python3 /opt/janus/ops/run_node.sh pm_redeem -m nodes.redeem_polymarket.run'
