+    def _write_through(self, asset_id: str, fetched: FetchedBook, compared: tuple[dict, dict]) -> None:
+        """L148 (2026-09-17): make an adopted REST correction survive the next websocket update.
+
+        `BookReplica.reconcile` adopts REST into the REPLICA only. The stream folds every later
+        `price_change` into its own ladder, `stream.books`, and rebuilds the replica from it
+        whole (`project_in`, no `ladder_key`) -- so a correction lasted exactly one message and the
+        stale level came back labelled "ws" (L146 R3, reproduced against deployed 59dd5ae).
+
+        Replace the stream's ladder with the same REST ladder, keeping its tick size, but ONLY when
+        the stream's ladder is provably the one REST disagreed with. The caller passes `compared`
+        only when a replica that was SYNCED immediately before `reconcile` reported the mismatch,
+        and only when no registration on the asset was superseded. This method then requires the
+        stream's current ladder to equal `compared`. Together these close three ways an adversarial
+        review (2026-09-17) made a first version overwrite newer websocket depth:
+
+        * a second owner of the asset that never received a `book` stays DISCONNECTED, is never
+          superseded (`project_in` does not bump a replica that is not SYNCED), and always
+          mismatches -- so "any registration mismatched" was not evidence about `stream.books`;
+        * a replica invalidated by `check()` (HEARTBEAT_LOST) during the flight is likewise never
+          superseded while later frames fold into `stream.books`;
+        * a malformed `book` after a drift recreates an EMPTY entry (`parse_event` calls
+          `setdefault` before `apply_book` raises), so mere presence proved nothing.
+
+        An absent entry is left absent: a drift dropped it and the websocket resnapshot owns
+        recovery. A fresh `AssetBook` rather than an in-place edit, so its sorted-ladder memo cannot
+        outlive the data.
+
+        KNOWN COST, fail-closed: if REST has already seen two or more venue changes whose websocket
+        frames are handled only after this runs, and a later one moves the top of book, the earlier
+        frame's claim will disagree with the corrected ladder. That is reported as drift, the
+        replica is invalidated and a resnapshot is queued -- a brief outage on that market, never a
+        wrong price. Polymarket offers no sequence number that would let this be told apart.
+        """
+        old = self.stream.books.get(asset_id)
+        if old is None:
+            return
+        want_bids, want_asks = compared
+        if not (BookReplica._close(old.bids, want_bids, 1e-9)
+                and BookReplica._close(old.asks, want_asks, 1e-9)):
+            return   # the stream's ladder changed in a way no registration observed; leave it
+        self.stream.books[asset_id] = AssetBook(
+            bids={float(p): float(s) for p, s in fetched.bids if float(s) > SIZE_EPS},
+            asks={float(p): float(s) for p, s in fetched.asks if float(s) > SIZE_EPS},
+            tick_size=old.tick_size)
+
     def once(self, now: float | None = None, mono: float | None = None) -> list[str]:
         """One pass, synchronous, on the calling thread. Returns the asset ids reconciled."""
